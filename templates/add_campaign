
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Campaign</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>

<header>
    <h1>Charity Funds Management System</h1>
    <p>Admin - Add New Campaign</p>
</header>

<section class="hero">
    <h2>Create Charity Campaign</h2>

    {% with messages = get_flashed_messages() %}
        {% for message in messages %}
            <p>{{ message }}</p>
        {% endfor %}
    {% endwith %}

    <form method="POST">
        <p>Campaign Name</p>
        <input type="text" name="campaign_name"
               placeholder="Enter campaign name" required>

        <p>Description</p>
        <textarea name="description"
                  placeholder="Enter campaign description"
                  required></textarea>

        <p>Target Amount (₹)</p>
        <input type="number" name="target_amount"
               min="1" step="0.01"
               placeholder="Enter target amount" required>

        <button type="submit" class="btn">Add Campaign</button>
    </form>

    <p><a href="/admin-dashboard">Back to Admin Dashboard</a></p>
</section>

<footer>
    <p>© 2026 Charity Funds Management System</p>
</footer>

</body>
</html>
