
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expense History</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>

<header>
    <h1>Charity Funds Management System</h1>
    <p>Admin - Expense History</p>
</header>

<section class="hero">
    <h2>All Campaign Expenses</h2>

    {% if expenses %}
    <table>
        <tr>
            <th>Expense ID</th>
            <th>Campaign</th>
            <th>Description</th>
            <th>Amount (₹)</th>
            <th>Date</th>
        </tr>

        {% for expense in expenses %}
        <tr>
            <td>{{ expense[0] }}</td>
            <td>{{ expense[1] }}</td>
            <td>{{ expense[2] }}</td>
            <td>₹{{ expense[3] }}</td>
            <td>{{ expense[4] }}</td>
        </tr>
        {% endfor %}
    </table>

    {% else %}
        <p>No expenses recorded yet.</p>
    {% endif %}

    <p><a href="/admin-dashboard">Back to Admin Dashboard</a></p>
</section>

<footer>
    <p>© 2026 Charity Funds Management System</p>
</footer>

</body>
</html>

